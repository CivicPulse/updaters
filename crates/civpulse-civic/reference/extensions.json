  {
    "name": "search_records_requests",
    "description": "Search records requests using the existing public or owner/admin-managed visibility gate. managed=true includes only requests the caller can manage. Pages contain at most 25 rows.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "maxLength": 500,
          "default": ""
        },
        "stage": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "draft",
            "submitted",
            "initial_response",
            "in_progress",
            "appeal",
            "closed",
            null
          ],
          "default": null
        },
        "organization_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "managed": {
          "type": "boolean",
          "default": false
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000,
          "default": 0
        }
      },
      "required": [],
      "additionalProperties": false
