# Offline acceptance harness only: no production credentials, source polling or real DB/R2.
FROM rust:1.99.1-bookworm@sha256:9181b56c2a21ab1d5e73cffe04fc762426d30aa7fac3c91141dd033f49a7fc8b AS build
WORKDIR /build
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
COPY tools ./tools
RUN cargo build --locked --release --package civpulse-results-collector --example measure
FROM gcr.io/distroless/cc-debian13:nonroot@sha256:08476c244888bfb425bae1ae4dd7c17f093e972aab8426883d97f3c6f280f7c1
COPY --from=build /build/target/release/examples/measure /usr/local/bin/civpulse-measure
COPY resource-fixture.json /fixtures/resource-case.json
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/civpulse-measure"]
CMD ["/fixtures/resource-case.json", "2026-11-03", "--pipeline", "160", "4178"]
